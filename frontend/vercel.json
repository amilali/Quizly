{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://fiber-subwoofer-dwarf.ngrok-free.dev/api/$1"
    },
    {
      "source": "/ws/(.*)",
      "destination": "https://fiber-subwoofer-dwarf.ngrok-free.dev/ws/$1"
    },
    {
      "source": "/((?!api/|ws/).*)",
      "destination": "/index.html"
    }
  ]
}
